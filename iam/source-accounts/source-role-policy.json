{
  "Description": "Deploy this IAM role in each SOURCE account to allow assuming central AMP role",
  "RoleName": "AMP-RemoteWrite-Role",
  "TrustPolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AllowEKSPodToAssume",
        "Effect": "Allow",
        "Principal": {
          "Federated": "arn:aws:iam::SOURCE_ACCOUNT_ID:oidc-provider/oidc.eks.REGION.amazonaws.com/id/OIDC_ID"
        },
        "Action": "sts:AssumeRoleWithWebIdentity",
        "Condition": {
          "StringEquals": {
            "oidc.eks.REGION.amazonaws.com/id/OIDC_ID:sub": "system:serviceaccount:monitoring:amp-sa",
            "oidc.eks.REGION.amazonaws.com/id/OIDC_ID:aud": "sts.amazonaws.com"
          }
        }
      }
    ]
  },
  "PermissionPolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AssumeCentralAMPRole",
        "Effect": "Allow",
        "Action": "sts:AssumeRole",
        "Resource": "arn:aws:iam::426336593251:role/AMP-CrossAccount-RemoteWrite"
      }
    ]
  }
}
